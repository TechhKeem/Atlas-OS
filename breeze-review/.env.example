# --- Supabase (server only; never expose the service-role key) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (server only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Calendly ---
# Round-robin event type URL (public; used by the inline widget)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-team/breeze-review
# Signing key from the Calendly webhook subscription (invitee.created / invitee.canceled)
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Google Sheets one-way mirror (service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n sequences, wrapped in quotes
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Leads!A:N

# --- Agency config ---
# Comma-separated state codes BFG serves (empty = all states). Compliance must set this.
NEXT_PUBLIC_SERVED_STATES=
NEXT_PUBLIC_LICENSING_DISCLOSURE=
NEXT_PUBLIC_CONTACT_EMAIL=privacy@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Retention ---
DOCUMENT_RETENTION_DAYS=30
# 0 = keep structured lead data until a deletion request. Compliance may change.
STRUCTURED_RETENTION_DAYS=0

# --- Scheduled jobs (Netlify scheduled functions call these routes) ---
CRON_SECRET=
