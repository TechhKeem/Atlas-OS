# Security headers. Read by Cloudflare Pages and Netlify.
# A Content-Security-Policy is added after the PayPal embed is in, because it must allow PayPal's domains.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
